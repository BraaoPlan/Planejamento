# ========================================================
# QUALIMED (SIGQ) - CONFIGURAÇÃO DE AMBIENTE
# Plataforma Integrada de Gestão da Qualidade - MedSênior
# ========================================================

# Porta do servidor HTTP
PORT=3000

# Ambiente de execução: development | production | test
NODE_ENV=production

# Chave secreta de assinatura dos tokens JWT locais
# IMPORTANTE: Altere para uma chave secreta forte e aleatória em produção
JWT_SECRET=qualimed_security_jwt_secret_medsenior_2026_change_in_production

# Caminho para o arquivo do banco de dados SQLite
DATABASE_PATH=qualimed.sqlite

# Senha padrão inicial para provisionamento do perfil GESTOR
ADMIN_DEFAULT_PASSWORD=DefinaUmaSenhaSegura2026!
